# Copy this file to .env.local (same folder) and fill in your real key.
# .env.local is read by serve.mjs and is never sent to the browser.
# Get a key at https://platform.openai.com/api-keys — this feature calls
# OpenAI's gpt-4o-mini with vision, which needs a small amount of paid credit
# on your OpenAI account (not part of a ChatGPT Plus subscription).
OPENAI_API_KEY=sk-...
